diff --git a/music_assistant/providers/spotify_connect/provider.py b/music_assistant/providers/spotify_connect/provider.py
index d039016..82a7818 100644
--- a/music_assistant/providers/spotify_connect/provider.py
+++ b/music_assistant/providers/spotify_connect/provider.py
@@ -87,0 +88 @@ CONF_AUDIO_QUALITY = "audio_quality"
+CONF_ZEROCONF_PORT = "zeroconf_port"
@@ -264,0 +266,5 @@ class SpotifyConnectProvider(PluginProvider):
+            ConfigEntry(
+                key=CONF_ZEROCONF_PORT,
+                type=ConfigEntryType.INTEGER,
+                default_value=0,
+            ),
@@ -781,0 +788 @@ class SpotifyConnectProvider(PluginProvider):
+            zeroconf_port=self._resolve_zeroconf_port(),
@@ -807,0 +815,5 @@ class SpotifyConnectProvider(PluginProvider):
+    def _resolve_zeroconf_port(self) -> int:
+        """Return the fixed zeroconf discovery port (0 = random)."""
+        value = cast("int | None", self.config.get_value(CONF_ZEROCONF_PORT))
+        return max(0, min(int(value or 0), 65535))
+

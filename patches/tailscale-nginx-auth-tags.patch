+// parseTags splits a comma-separated tag list, dropping empty entries.
+func parseTags(raw string) []string {
+	var tags []string
+	for tag := range strings.SplitSeq(raw, ",") {
+		if tag = strings.TrimSpace(tag); tag != "" {
+			tags = append(tags, tag)
+		}
+	}
+	return tags
+}
+
+// authorizeNode reports why node may not connect, or "" if it may. With no
+// allowed tags only untagged nodes are accepted; otherwise the node must
+// carry at least one of allowedTags.
+func authorizeNode(node *tailcfg.Node, allowedTags []string) string {
+	if len(allowedTags) == 0 {
+		if node.IsTagged() {
+			return "node " + node.Hostinfo.Hostname() + " is tagged"
+		}
+		return ""
+	}
+	for _, tag := range node.Tags {
+		if slices.Contains(allowedTags, tag) {
+			return ""
+		}
+	}
+	return "node " + node.Hostinfo.Hostname() + " has tags [" + strings.Join(node.Tags, ",") + "], wanted one of [" + strings.Join(allowedTags, ",") + "]"
+}

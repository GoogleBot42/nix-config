@@ -0,0 +1,49 @@
+// Copyright (c) Tailscale Inc & contributors
+// SPDX-License-Identifier: BSD-3-Clause
+
+//go:build linux
+
+package main
+
+import (
+	"slices"
+	"testing"
+
+	"tailscale.com/tailcfg"
+)
+
+func TestParseTags(t *testing.T) {
+	got := parseTags(" tag:a, ,tag:b,")
+	if want := []string{"tag:a", "tag:b"}; !slices.Equal(got, want) {
+		t.Fatalf("parseTags = %v, want %v", got, want)
+	}
+	if got := parseTags(""); got != nil {
+		t.Fatalf("parseTags(\"\") = %v, want nil", got)
+	}
+}
+
+func TestAuthorizeNode(t *testing.T) {
+	tests := []struct {
+		name    string
+		tags    []string
+		allowed []string
+		ok      bool
+	}{
+		{"untagged, no allowlist", nil, nil, true},
+		{"tagged, no allowlist", []string{"tag:server"}, nil, false},
+		{"tag in allowlist", []string{"tag:server", "tag:workstation"}, []string{"tag:workstation"}, true},
+		{"tag not in allowlist", []string{"tag:claude"}, []string{"tag:server", "tag:workstation"}, false},
+		{"untagged, allowlist", nil, []string{"tag:server"}, false},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			node := &tailcfg.Node{
+				Hostinfo: (&tailcfg.Hostinfo{Hostname: "device"}).View(),
+				Tags:     tt.tags,
+			}
+			if reason := authorizeNode(node, tt.allowed); (reason == "") != tt.ok {
+				t.Fatalf("authorizeNode = %q, want ok=%v", reason, tt.ok)
+			}
+		})
+	}
+}

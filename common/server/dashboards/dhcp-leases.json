{
  "uid": "dhcp-leases",
  "title": "DHCP leases",
  "description": "dnsmasq lease table and DNS cache counters from the gateway's dnsmasq_exporter. One row per active lease; static leases appear once the device has asked for its address.",
  "tags": ["fleet", "network"],
  "editable": true,
  "graphTooltip": 1,
  "refresh": "1m",
  "schemaVersion": 39,
  "time": { "from": "now-24h", "to": "now" },
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "name": "instance",
        "label": "Gateway",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "victoriametrics" },
        "query": "label_values(dnsmasq_leases, instance)",
        "definition": "label_values(dnsmasq_leases, instance)",
        "refresh": 1,
        "sort": 1,
        "current": { "text": "leela", "value": "leela" }
      },
      {
        "name": "search",
        "label": "Filter (regex on host, MAC or address)",
        "type": "textbox",
        "query": ".*",
        "current": { "text": ".*", "value": ".*" }
      }
    ]
  },
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Active leases",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [{ "refId": "A", "expr": "dnsmasq_leases{instance=\"$instance\"}" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "none", "graphMode": "area", "textMode": "value" },
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 0 } }
    },
    {
      "id": 2, "type": "stat", "title": "DNS cache size",
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [{ "refId": "A", "expr": "dnsmasq_cachesize{instance=\"$instance\"}" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "none", "graphMode": "none", "textMode": "value" },
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 0 } }
    },
    {
      "id": 3, "type": "stat", "title": "Cache hit ratio (1h)",
      "gridPos": { "x": 8, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [{ "refId": "A", "expr": "increase(dnsmasq_hits{instance=\"$instance\"}[1h]) / (increase(dnsmasq_hits{instance=\"$instance\"}[1h]) + increase(dnsmasq_misses{instance=\"$instance\"}[1h]))" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "none", "graphMode": "area", "textMode": "value" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "decimals": 0, "min": 0, "max": 1 } }
    },
    {
      "id": 4, "type": "timeseries", "title": "DNS queries per second",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [
        { "refId": "A", "expr": "rate(dnsmasq_hits{instance=\"$instance\"}[5m])", "legendFormat": "cache hits" },
        { "refId": "B", "expr": "rate(dnsmasq_misses{instance=\"$instance\"}[5m])", "legendFormat": "cache misses (forwarded)" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "fillOpacity": 15, "stacking": { "mode": "normal" } } } },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 10, "type": "table", "title": "Leases",
      "gridPos": { "x": 0, "y": 4, "w": 24, "h": 18 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [{
        "refId": "A",
        "expr": "dnsmasq_lease_expiry{instance=\"$instance\", computer_name=~\"$search\"} or dnsmasq_lease_expiry{instance=\"$instance\", mac_addr=~\"$search\"} or dnsmasq_lease_expiry{instance=\"$instance\", ip_addr=~\"$search\"}",
        "format": "table",
        "instant": true
      }],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "__name__": true, "job": true, "instance": true },
            "indexByName": { "computer_name": 0, "ip_addr": 1, "mac_addr": 2, "Value": 3, "client_id": 4 },
            "renameByName": { "computer_name": "Host", "ip_addr": "Address", "mac_addr": "MAC", "Value": "Lease expires", "client_id": "Client id" }
          }
        },
        {
          "id": "calculateField",
          "options": {
            "mode": "binary",
            "binary": { "left": "Lease expires", "operator": "*", "right": "1000" },
            "alias": "Expires",
            "replaceFields": false
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Lease expires": true },
            "indexByName": { "Host": 0, "Address": 1, "MAC": 2, "Expires": 3, "Client id": 4 }
          }
        }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "align": "left", "filterable": true } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Expires" }, "properties": [ { "id": "unit", "value": "dateTimeFromNow" }, { "id": "custom.width", "value": 160 } ] },
          { "matcher": { "id": "byName", "options": "MAC" }, "properties": [ { "id": "custom.width", "value": 170 } ] },
          { "matcher": { "id": "byName", "options": "Address" }, "properties": [ { "id": "custom.width", "value": 150 } ] }
        ]
      },
      "options": { "showHeader": true, "sortBy": [ { "displayName": "Address", "desc": false } ], "footer": { "show": true, "reducer": ["count"], "fields": ["Address"] } }
    },
    {
      "id": 11, "type": "timeseries", "title": "Active leases over time",
      "gridPos": { "x": 0, "y": 22, "w": 24, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [{ "refId": "A", "expr": "dnsmasq_leases{instance=\"$instance\"}", "legendFormat": "leases" }],
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 0, "custom": { "fillOpacity": 10 } } },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "single" } }
    }
  ]
}
